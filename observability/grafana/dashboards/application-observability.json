{
  "title": "Observabilidade - API e banco",
  "uid": "application-observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "API disponivel", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=\"checkout-api\"}", "legendFormat": "API"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"id": 2, "type": "stat", "title": "Checkout p95", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(checkout_http_request_duration_seconds_bucket{path=\"/checkout\"}[2m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}}}},
    {"id": 3, "type": "stat", "title": "Falhas de checkout", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(increase(checkout_errors_total[15m]))", "legendFormat": "erros"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}}},
    {"id": 4, "type": "stat", "title": "Pool esperando", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "checkout_db_pool_waiting", "legendFormat": "waiting"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}},
    {"id": 5, "type": "timeseries", "title": "Latencia do checkout", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(checkout_http_request_duration_seconds_bucket{path=\"/checkout\"}[1m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.50, sum by (le) (rate(checkout_http_request_duration_seconds_bucket{path=\"/checkout\"}[1m])))", "legendFormat": "p50"}, {"expr": "rate(checkout_http_request_duration_seconds_sum{path=\"/checkout\"}[1m]) / rate(checkout_http_request_duration_seconds_count{path=\"/checkout\"}[1m])", "legendFormat": "media"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 6, "type": "timeseries", "title": "Pool de conexoes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "checkout_db_pool_in_use", "legendFormat": "em uso"}, {"expr": "checkout_db_pool_waiting", "legendFormat": "esperando"}, {"expr": "checkout_db_pool_size", "legendFormat": "tamanho"}]},
    {"id": 7, "type": "timeseries", "title": "Taxa de erros", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (reason) (rate(checkout_errors_total[1m]))", "legendFormat": "{{reason}}"}]},
    {"id": 8, "type": "timeseries", "title": "Banco - conexoes ativas", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT now() AS time, count(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database();", "format": "time_series", "refId": "A"}]},
    {"id": 9, "type": "logs", "title": "Eventos de pool", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 21}, "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{container=\"api-up\"} |~ \"pool|checkout_failed\"", "refId": "A"}]}
  ],
  "links": [{"title": "Jaeger - traces", "url": "https://jaeger-ps.joaoxavier.app.br/search?service=checkout-api"}, {"title": "Carga k6", "url": "/d/k6-checkout-load"}, {"title": "Visao da demonstracao", "url": "/d/presentation-overview"}]
}
