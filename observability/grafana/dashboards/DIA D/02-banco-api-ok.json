{
  "title": "02 - Banco e Python/API OK",
  "uid": "application-observability",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "API disponível", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=\"checkout-api\"}", "legendFormat": "API"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"id": 2, "type": "stat", "title": "Banco disponível", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT CASE WHEN pg_is_in_recovery() THEN 0 ELSE 1 END AS value;", "format": "table", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "INDISPONÍVEL", "color": "red"}, "1": {"text": "ONLINE", "color": "green"}}}]}}},
    {"id": 3, "type": "stat", "title": "Conexões ativas", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT count(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database();", "format": "table", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 20}, {"color": "red", "value": 50}]}}}},
    {"id": 4, "type": "stat", "title": "Tamanho do banco", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT pg_database_size(current_database())::double precision AS value;", "format": "table", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "decimals": 1}}},
    {"id": 5, "type": "timeseries", "title": "PostgreSQL - sessões por estado", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT now() AS time, COALESCE(state, 'unknown') AS metric, count(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database() GROUP BY state;", "format": "time_series", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}},
    {"id": 6, "type": "timeseries", "title": "Pool da API", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "checkout_db_pool_in_use", "legendFormat": "em uso"}, {"expr": "checkout_db_pool_waiting", "legendFormat": "esperando"}, {"expr": "checkout_db_pool_size", "legendFormat": "tamanho"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}},
    {"id": 7, "type": "timeseries", "title": "PostgreSQL - locks aguardando", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT now() AS time, count(*)::double precision AS value FROM pg_locks WHERE NOT granted;", "format": "time_series", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}}},
    {"id": 8, "type": "timeseries", "title": "Banco - conexões ativas ao longo do tempo", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "postgres", "uid": "postgres"}, "targets": [{"rawSql": "SELECT now() AS time, count(*)::double precision AS value FROM pg_stat_activity WHERE datname = current_database();", "format": "time_series", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}}
  ],
  "links": [{"title": "Visão operacional", "url": "/d/presentation-overview"}, {"title": "Traces e erros", "url": "/d/traces-logs-metricas-erros"}]
}
