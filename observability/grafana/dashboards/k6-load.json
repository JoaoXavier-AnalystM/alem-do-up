{
  "title": "Carga k6 — checkout",
  "uid": "k6-checkout-load",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Requisições por segundo", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{testid=\"checkout-load\"}[1m]))", "legendFormat": "req/s"}]},
    {"id": 2, "type": "stat", "title": "Falhas HTTP", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "100 * avg(k6_http_req_failed_rate{testid=\"checkout-load\"})", "legendFormat": "%"}]},
    {"id": 3, "type": "stat", "title": "Usuários virtuais", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "max(k6_vus{testid=\"checkout-load\"})", "legendFormat": "VUs"}]},
    {"id": 4, "type": "stat", "title": "Checks aprovados", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "100 * avg(k6_checks_rate{testid=\"checkout-load\", check=\"checkout responded\"})", "legendFormat": "%"}]},
    {"id": 5, "type": "timeseries", "title": "Latência HTTP", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "targets": [{"expr": "max(k6_http_req_duration_seconds_p95{testid=\"checkout-load\"})", "legendFormat": "p95"}, {"expr": "max(k6_http_req_duration_seconds_p50{testid=\"checkout-load\"})", "legendFormat": "p50"}, {"expr": "max(k6_http_req_duration_seconds_avg{testid=\"checkout-load\"})", "legendFormat": "média"}]},
    {"id": 6, "type": "timeseries", "title": "Volume de requisições", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{testid=\"checkout-load\"}[1m]))", "legendFormat": "req/s"}]},
    {"id": 7, "type": "timeseries", "title": "Duração das iterações", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "targets": [{"expr": "max(k6_iteration_duration_seconds_p95{testid=\"checkout-load\"})", "legendFormat": "p95"}]},
    {"id": 8, "type": "timeseries", "title": "Checks", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "targets": [{"expr": "100 * avg(k6_checks_rate{testid=\"checkout-load\"})", "legendFormat": "aprovados %"}]}
  ]
}
