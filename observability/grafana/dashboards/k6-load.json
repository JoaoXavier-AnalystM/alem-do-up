{
  "title": "Carga k6 - checkout",
  "uid": "k6-checkout-load",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Requisicoes por segundo", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{testid=~\"checkout-.*\"}[1m]))", "legendFormat": "req/s"}]},
    {"id": 2, "type": "stat", "title": "Falhas HTTP", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "100 * avg(k6_http_req_failed_rate{testid=~\"checkout-.*\"})", "legendFormat": "%"}]},
    {"id": 3, "type": "stat", "title": "Usuarios virtuais", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "max(k6_vus{testid=~\"checkout-.*\"})", "legendFormat": "VUs"}]},
    {"id": 4, "type": "stat", "title": "Checkouts aprovados", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "targets": [{"expr": "100 * avg(k6_checks_rate{testid=~\"checkout-.*\", check=\"checkout succeeded\"})", "legendFormat": "%"}]},
    {"id": 5, "type": "timeseries", "title": "Latencia HTTP", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "targets": [{"expr": "max(k6_http_req_duration_p95{testid=~\"checkout-.*\"})", "legendFormat": "p95"}, {"expr": "max(k6_http_req_duration_p50{testid=~\"checkout-.*\"})", "legendFormat": "p50"}, {"expr": "max(k6_http_req_duration_avg{testid=~\"checkout-.*\"})", "legendFormat": "media"}]},
    {"id": 6, "type": "timeseries", "title": "Volume de requisicoes", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "targets": [{"expr": "sum(rate(k6_http_reqs_total{testid=~\"checkout-.*\"}[1m]))", "legendFormat": "req/s"}]},
    {"id": 7, "type": "timeseries", "title": "Duracao das iteracoes", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "targets": [{"expr": "max(k6_iteration_duration_p95{testid=~\"checkout-.*\"})", "legendFormat": "p95"}]},
    {"id": 8, "type": "timeseries", "title": "Checks", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "targets": [{"expr": "100 * avg(k6_checks_rate{testid=~\"checkout-.*\"})", "legendFormat": "aprovados %"}]}
  ]
}
