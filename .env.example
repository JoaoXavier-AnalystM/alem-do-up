COMPOSE_PROJECT_NAME=up-but-not-healthy
APP_DB_IMAGE=timescale/timescaledb:latest-pg17
ZBX_DB_IMAGE=postgres:17.7-alpine

# Required secrets: fill these in your private .env file.
APP_DB_NAME=demo
APP_DB_USER=demo
APP_DB_PASSWORD=demo

ZBX_DB_NAME=zabbix
ZBX_DB_USER=zabbix
ZBX_DB_PASSWORD=zabbix

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=palestra-admin

# Zabbix datasource credentials for the Grafana plugin.
ZABBIX_API_USER=admin
ZABBIX_API_PASSWORD=zabbix

DB_POOL_MAX=5
INCIDENT_HOLD_SECONDS=8
ZBX_WEB_PORT=8081
ZBX_SERVER_PORT=10051
ZBX_AGENT_PORT=10150
ZBX_HOSTNAME=DevKit-Stack
PHP_TZ=America/Sao_Paulo
