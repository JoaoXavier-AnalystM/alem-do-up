# Credenciais exclusivas do OpenDockWatch.
# Gere AUTH_PASS_HASH conforme as instruções do README desta pasta.
AUTH_USER=admin
AUTH_PASS_HASH=
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# O acesso é direto pela porta 3001; não há proxy nesta primeira etapa.
TRUST_PROXY=false
OPENDOCKWATCH_PORT=3001
